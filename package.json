{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "optical-erp",
  "version": "1.0.0",
  "description": "Optical ERP Professional Windows Desktop Software",
  "homepage": "./",
  "main": "public/electron.js",
  "scripts": {
    "start": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "electron:dev": "concurrently \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.opticalerp.app",
    "productName": "Optical ERP",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "public/electron.js",
      "public/preload.js",
      "public/splash.html",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config",
        "filter": ["**/*", "!database.json"]
      }
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  }
}
